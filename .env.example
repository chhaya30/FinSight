# Application
APP_NAME=globalrisk-ai
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/globalrisk
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM Providers (choose one)
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# OLLAMA
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:70b

# CLAUDE
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Embeddings
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIMENSION=1024

# Vector Store
VECTOR_STORE_PROVIDER=pgvector
PINECONE_API_KEY=
PINECONE_INDEX=globalrisk
PINECONE_ENVIRONMENT=us-east-1

# Market intelligence (GDELT DOC API is keyless)
MARKET_INTELLIGENCE_PROVIDER=gdelt
GDELT_DOC_API_URL=https://api.gdeltproject.org/api/v2/doc/doc
GDELT_MAX_RECORDS=10
GDELT_TIMEOUT_SECONDS=12
MARKET_NEWS_RSS_FALLBACK=true
GOOGLE_NEWS_RSS_URL=https://news.google.com/rss/search

# Industry intelligence (SEC EDGAR public filings; provide your real organization/contact)
INDUSTRY_INTELLIGENCE_PROVIDER=sec_edgar
SEC_EDGAR_USER_AGENT="Organization Name analyst@example.org"
SEC_EDGAR_TICKERS_URL=https://www.sec.gov/files/company_tickers_exchange.json
SEC_EDGAR_SUBMISSIONS_URL=https://data.sec.gov/submissions/CIK{cik}.json
SEC_EDGAR_TIMEOUT_SECONDS=12
SEC_EDGAR_PEER_CANDIDATES=50
SEC_EDGAR_MAX_PEERS=4

# Document Processing
CHUNK_SIZE=512
CHUNK_OVERLAP=50
MAX_CHUNKS_PER_DOC=500

# OCR
OCR_ENABLED=true
OCR_LANGUAGE=eng
TESSERACT_CMD=tesseract

# File Upload
UPLOAD_DIR=./data/raw/annual_reports
EXTRACTED_DIR=./data/extracted
PROCESSED_DIR=./data/processed
MAX_UPLOAD_SIZE_MB=100

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# Security
SECRET_KEY=dev-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Taxonomy
RISK_TAXONOMY_PATH=./app/taxonomy/data/risk_taxonomy_v1.json

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
