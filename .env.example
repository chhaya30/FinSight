# Application
APP_NAME=globalrisk-ai
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/globalrisk
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM Providers (choose one)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-70b-versatile

# OLLAMA
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:70b

# CLAUDE
CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Embeddings
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIMENSION=1024
OPENAI_API_KEY=your_openai_api_key_here

# Vector Store
VECTOR_STORE_PROVIDER=pgvector
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=globalrisk
PINECONE_ENVIRONMENT=us-east-1

# Document Processing
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_CHUNKS_PER_DOC=500

# OCR
OCR_ENABLED=true
OCR_LANGUAGE=eng
TESSERACT_CMD=tesseract

# File Upload
UPLOAD_DIR=./data/raw/annual_reports
EXTRACTED_DIR=./data/extracted
PROCESSED_DIR=./data/processed
MAX_UPLOAD_SIZE_MB=100

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# Security
SECRET_KEY=dev-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Taxonomy
RISK_TAXONOMY_PATH=./app/taxonomy/data/risk_taxonomy_v1.json