  "severity_levels": {
    "critical": {
      "weight": 5,
      "description": "Existential threat to business continuity; immediate board attention required"
    },
    "high": {
      "weight": 4,
      "description": "Significant impact on financials, operations, or reputation; urgent mitigation needed"
    },
    "medium": {
      "weight": 3,
      "description": "Moderate impact manageable with existing controls; monitoring required"
    },
    "low": {
      "weight": 2,
      "description": "Minor impact; routine monitoring sufficient"
    },
    "informational": {
      "weight": 1,
      "description": "Disclosed for transparency; no immediate action required"
    }
  },
